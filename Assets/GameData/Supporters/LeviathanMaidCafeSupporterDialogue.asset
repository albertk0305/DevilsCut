  supporter: {fileID: 11400000, guid: 393f560ec2c52ed45bbb5f5324003c40, type: 2}
  defaultSprite: {fileID: 21300000, guid: 02de2da66a5ac0e4b862b00770b82e0e, type: 3}
  happySprite: {fileID: 21300000, guid: 856ee14d7696f0846a2e0ba058841b34, type: 3}
