  selectedExpression: 0
  selectedTextKey: maid_belphegor_partner_intro
  selectedText: Yaaawn... Thanks for calling me... If this is a course where we sit
    and rest then I am confident...
  giftExpression: 0
  giftTextKey: maid_belphegor_partner_gift
  giftText: I brought... a gift... It might have a little luck stuck to it...
  maxSkillGiftExpression: 0
  maxSkillGiftTextKey: maid_belphegor_partner_extra_gift
  maxSkillGiftText: Mnya... There was one more... The more you have the better the
